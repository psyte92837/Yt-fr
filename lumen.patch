@@ -0,0 +1,39 @@
+# Lumen: applies lumen.patch (from the repository root) to the current branch, commits and pushes.
+# Run it once from the Actions tab: "Lumen: apply patch" -> Run workflow.
+name: "Lumen: apply patch"
+
+on:
+  workflow_dispatch:
+
+permissions:
+  contents: write
+
+jobs:
+  apply:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      - name: Apply lumen.patch
+        run: |
+          set -e
+          git config user.name "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+          if [ ! -f lumen.patch ]; then
+            echo "::error::lumen.patch not found in the repository root. Upload it first (Add file -> Upload files)."
+            exit 1
+          fi
+          if [ -d app/src/main/java/org/schabi/newpipe/lumen ]; then
+            echo "::notice::Lumen is already applied, nothing to do."
+            exit 0
+          fi
+          # make the base commit available in case the fork is newer than the patch
+          git fetch --no-tags https://github.com/TeamNewPipe/NewPipe.git acb7dfd658a8478686d0f8a0c389269d0ca8df95 2>/dev/null || true
+          cp lumen.patch "$RUNNER_TEMP/lumen.patch"
+          git rm -q --cached lumen.patch && rm lumen.patch
+          git commit -q -m "Remove lumen.patch before applying"
+          git am --3way "$RUNNER_TEMP/lumen.patch"
+          git push origin "HEAD:${GITHUB_REF_NAME}"
+          echo "::notice::Lumen applied. Now run 'Lumen: build APK' from the Actions tab."
