<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same rule for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="lumen_vault.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="lumen_vault.xml" />
    </device-transfer>
</data-extraction-rules>
