+object Csv {
+    fun cell(v: Any?): String {
+        val s = v?.toString() ?: ""
+        return if (s.any { it == ',' || it == '"' || it == '\n' || it == '\r' || it == ';' }) {
+            "\"" + s.replace("\"", "\"\"") + "\""
+        } else {
+            s
+        }
+    }
+
+    fun row(vararg v: Any?): String = v.joinToString(",") { cell(it) } + "\r\n"
+}
