<?xml version="1.0" encoding="utf-8"?>
<!-- Lumen Lens edition: adds the accessibility service. Kept out of the "std" edition, because Play Protect
     blocks sideloaded apps that declare an accessibility service. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- ===== Lumen ===== -->
        <!-- Lumen Lens: floating button over the YouTube app; reads the video cards on its screen (only YouTube windows are used) -->
        <service
            android:name="org.schabi.newpipe.lumen.LensService"
            android:exported="true"
            android:label="@string/lumen_lens"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lumen_lens" />
        </service>
        <!-- ===== /Lumen ===== -->
    </application>
</manifest>
