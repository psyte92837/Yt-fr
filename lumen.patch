+    fun <T> spinner(label: String, options: List<Pair<T, String>>, selected: T, onSelect: (T) -> Unit): Spinner {
+        add(text(ctx, label, Type.LABEL, bold = true, color = Palette.MUTED), 12)
+        return add(spin(ctx, options, selected, onSelect), 4)
+    }
