<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext (http) is allowed so a local Ollama / LM Studio server on the LAN can be used. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
